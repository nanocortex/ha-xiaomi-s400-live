{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Xiaomi S400 scale",
        "description": "Pick a discovered scale or enter its Bluetooth MAC address. The scale must be in range of a Home Assistant Bluetooth adapter or an ESPHome Bluetooth proxy with `active: true`.",
        "data": {
          "address": "MAC address"
        }
      },
      "credentials": {
        "title": "Login token",
        "description": "Scale {address}. Paste the 24 hex character **TOKEN** shown for this scale by Xiaomi-cloud-tokens-extractor (not the 32 character BLE KEY).",
        "data": {
          "token": "Token",
          "bindkey": "BLE key (optional)",
          "name": "Name"
        },
        "data_description": {
          "token": "24 hex characters, e.g. 0123456789abcdef01234567",
          "bindkey": "32 hex characters (BLE KEY from the extractor). Optional, only needed for heart rate, which the scale sends in its broadcast instead of the GATT stream."
        }
      },
      "reauth_confirm": {
        "title": "Token rejected",
        "description": "The scale rejected the login token. This happens after the scale was reset or re-added in Mi Home. Extract the token again and paste it here.",
        "data": {
          "token": "Token"
        },
        "data_description": {
          "token": "24 hex characters, e.g. 0123456789abcdef01234567"
        }
      },
      "reconfigure": {
        "title": "Change keys",
        "data": {
          "token": "Token",
          "bindkey": "BLE key (optional)"
        },
        "data_description": {
          "token": "24 hex characters, e.g. 0123456789abcdef01234567",
          "bindkey": "32 hex characters (BLE KEY from the extractor). Optional, only needed for heart rate, which the scale sends in its broadcast instead of the GATT stream."
        }
      }
    },
    "error": {
      "invalid_mac": "Invalid MAC address (expected AA:BB:CC:DD:EE:FF)",
      "invalid_token": "Token must be exactly 24 hex characters",
      "invalid_bindkey": "BLE key must be exactly 32 hex characters"
    },
    "abort": {
      "already_configured": "This scale is already configured",
      "not_supported": "This device is not a Xiaomi S400",
      "reauth_successful": "Token updated",
      "reconfigure_successful": "Token updated"
    }
  },
  "config_subentries": {
    "person": {
      "entry_type": "Person",
      "initiate_flow": {
        "user": "Add person",
        "reconfigure": "Edit person"
      },
      "step": {
        "user": {
          "title": "Person",
          "description": "Map a scale user profile to a person. Weigh in alone once and check the **Profile ID** sensor to find which number is yours.",
          "data": {
            "name": "Name",
            "profile_id": "Scale profile ID",
            "sex": "Sex",
            "birthday": "Date of birth",
            "height": "Height"
          }
        },
        "reconfigure": {
          "title": "Person",
          "description": "Map a scale user profile to a person. Weigh in alone once and check the **Profile ID** sensor to find which number is yours.",
          "data": {
            "name": "Name",
            "profile_id": "Scale profile ID",
            "sex": "Sex",
            "birthday": "Date of birth",
            "height": "Height"
          }
        }
      },
      "error": {
        "profile_in_use": "Another person already uses this profile ID"
      },
      "abort": {
        "reconfigure_successful": "Token updated"
      }
    }
  },
  "selector": {
